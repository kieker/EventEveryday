# Copy to .env on the VM only. Use unique credentials and a real domain.
POSTGRES_DB=eventeveryday
POSTGRES_USER=eventeveryday
POSTGRES_PASSWORD=replace-with-a-unique-password
DATABASE_URL=postgresql://eventeveryday:replace-with-a-unique-password@db:5432/eventeveryday
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
SITE_DOMAIN=eventeveryday.kiekerweb.co.za
DJANGO_ALLOWED_HOSTS=eventeveryday.kiekerweb.co.za,backend
DJANGO_CORS_ALLOWED_ORIGINS=https://eventeveryday.kiekerweb.co.za
NEXT_PUBLIC_API_URL=https://eventeveryday.kiekerweb.co.za/api
PUBLIC_FRONTEND_URL=https://eventeveryday.kiekerweb.co.za
PUBLIC_BACKEND_URL=https://eventeveryday.kiekerweb.co.za
PAYFAST_NOTIFY_URL=https://eventeveryday.kiekerweb.co.za/api/payments/payfast/notify/
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Keep mail in Mailpit until a real sender is deliberately configured.
EMAIL_PROVIDER=smtp
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=EventEveryday <bookings@example.com>
