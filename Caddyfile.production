{$SITE_DOMAIN} {
    handle /static/* {
        root * /srv
        file_server
    }

    handle /media/* {
        root * /srv
        file_server
    }

    @backend path /api /api/* /admin /admin/*
    handle @backend {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
