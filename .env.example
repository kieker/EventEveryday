# Copy this file to .env for local development.
POSTGRES_DB=eventeveryday
POSTGRES_USER=eventeveryday
POSTGRES_PASSWORD=eventeveryday_dev
DATABASE_URL=postgresql://eventeveryday:eventeveryday_dev@db:5432/eventeveryday

DJANGO_SECRET_KEY=development-only-change-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Compose supplies Redis by default. Outside Docker use your shared Redis URL.
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
# Comma-separated proxy IPs/CIDRs; leave empty for direct connections.
RATE_LIMIT_TRUSTED_PROXIES=

NEXT_PUBLIC_API_URL=http://localhost:8000/api
INTERNAL_API_URL=http://backend:8000/api

# On a VM behind Caddy, set this to 127.0.0.1 and use your real DNS name.
HOST_BIND_IP=0.0.0.0
SITE_DOMAIN=

# PayFast sandbox configuration will be activated in the payment stage.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_PROCESS_URL=https://sandbox.payfast.co.za/eng/process
PAYFAST_VALIDATE_URL=https://sandbox.payfast.co.za/eng/query/validate
# PayFast must reach this URL from the internet. Use a tunnel during local testing.
PAYFAST_NOTIFY_URL=
# Enable only behind a trusted proxy/tunnel that replaces X-Forwarded-For.
PAYFAST_TRUST_X_FORWARDED_FOR=false
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000

# Local development sends to Mailpit. Set EMAIL_PROVIDER=resend and add the
# secret API key only in .env when using Resend.
EMAIL_PROVIDER=smtp
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=EventEveryday <bookings@eventeveryday.local>
EMAIL_REPLY_TO=

# Optional local-only administrator seed. Leave blank to disable.
DEV_ADMIN_USERNAME=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
