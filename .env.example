# Copy this file to .env for local development.
POSTGRES_DB=eventeveryday
POSTGRES_USER=eventeveryday
POSTGRES_PASSWORD=eventeveryday_dev
DATABASE_URL=postgresql://eventeveryday:eventeveryday_dev@db:5432/eventeveryday

DJANGO_SECRET_KEY=development-only-change-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000/api
INTERNAL_API_URL=http://backend:8000/api

# PayFast sandbox configuration will be activated in the payment stage.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Optional local-only administrator seed. Leave blank to disable.
DEV_ADMIN_USERNAME=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

